# ==============================================================================
# NEXUS MULTI-AGENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (for LLM reasoning & question generation via gemini-3.5-flash)
GOOGLE_API_KEY=your_google_api_key_here

# Murf AI API Key (for Falcon real-time voice streaming)
MURF_API_KEY=your_murf_api_key_here

# AssemblyAI API Key (for Speech-to-Text transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: Server Port (defaults to 8080 locally or $PORT in production)
PORT=8080
